# O servidor de deploy. Copie para `server.env` (mesma pasta) e preencha.
#
# ⚠️ O `server.env` NÃO vai para o git — ele guarda a SENHA do servidor.
#    (O .gitignore já o bloqueia.)
#
# É o único arquivo que você preenche por SERVIDOR (não por aplicação): as suas apps que
# vivem na mesma máquina compartilham estes valores.

SSH_HOST=1.2.3.4
SSH_USER=root
SSH_PASSWORD=

# A pasta raiz onde as aplicações vivem no servidor. O deploy cria, dentro dela, uma pasta
# com o PROJECT_NAME da app — então várias apps convivem sem se atropelar:
#
#     /opt/garius/customers/tcm/tcm-sfchortolandia-api/
#     /opt/garius/customers/tcm/tcm-workflows/
#
REMOTE_ROOT=/opt/garius/customers/tcm
