# Copie para `.env` e preencha. O `.env` NÃO vai para o git.
#
# Só entra aqui o que NÃO é segredo. Senha de banco, chave de criptografia e
# chave do JWT vêm do Google Secret Manager — nunca deste arquivo.
# (A única credencial neste diretório é secrets/gcp-service-account.json, que é
# a chave que destrava todas as outras.)

ASPNETCORE_ENVIRONMENT=Production

# Nome do projeto. Vira o nome dos containers (<PROJECT_NAME>-api,
# <PROJECT_NAME>-migrations), o nome da imagem e o do router no Traefik.
# Precisa ser ÚNICO no servidor — dois projetos com o mesmo nome colidem.
PROJECT_NAME=gariustech-backend-template

# A tag da imagem publicada. Suba isto a cada deploy.
# Evite `latest`: com `latest` você não sabe o que está no ar, e um `pull` no
# servidor pode trazer algo que você não testou.
APP_VER=v0.1.0

# O domínio público. O Traefik emite o certificado Let's Encrypt para ele, então
# o DNS já precisa apontar para o servidor ANTES de subir.
APP_HOST=api.exemplo.com

# Conta no Docker Hub onde a imagem é publicada.
DOCKER_HUB_PROFILE=gariustech


# ─────────────────────────────────────────────────────────────────────────────
# INFRAESTRUTURA — o que a aplicação COBRA para subir.
#
# Ela falha FECHADA em cada um destes: sem o valor, o container NÃO sobe, e o log
# diz exatamente qual falta. Nenhum é opcional.
#
# ⚠️ Aqui vão ENDEREÇOS, nunca senhas. As senhas (banco, Redis, chaves) vivem no
# Google Secret Manager e chegam pela service account.
# ─────────────────────────────────────────────────────────────────────────────

# Nomes dos containers de Postgres e Redis na rede `garius_network`.
# NÃO use "localhost": dentro de um container, localhost é o PRÓPRIO container.
POSTGRES_HOST=postgres-prod
POSTGRES_PORT=5432
REDIS_HOST=redis-prod

# A rede Docker de onde o Traefik fala com a aplicação.
#
# Sem isto o ASP.NET IGNORA o X-Forwarded-For: todo request chega com o IP do
# Traefik, e o rate limit passa a tratar TODOS os usuários como um só. Pior: sem o
# X-Forwarded-Proto, o cookie de sessão sai SEM a flag Secure.
#
# Descubra o valor com:
#     docker network inspect garius_network --format '{{(index .IPAM.Config 0).Subnet}}'
TRAEFIK_NETWORK_CIDR=172.18.0.0/16

# De onde o frontend pode chamar a API (CORS). O default da aplicação é []: nega
# TUDO. É deliberado — uma configuração esquecida não pode virar uma API aberta.
CORS_ORIGIN=https://app.exemplo.com
