<Project>

  <!--
    Versionamento central de pacotes (CPM).
    Os .csproj referenciam pacotes SEM versão; a versão mora aqui, uma única vez.
    Isso é o que impede que apps derivadas deste template divirjam de versão.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / OpenAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.11" />
    <!--
      Pin transitivo de segurança: Microsoft.AspNetCore.OpenApi 10.0.9 traz
      Microsoft.OpenApi 2.0.0, que tem vulnerabilidade HIGH (GHSA-v5pm-xwqc-g5wc —
      DoS por referência circular de schema).

      Fica na linha 2.x (corrigida a partir da 2.7.5). NÃO subir para 3.x: a 3.x tem
      breaking change (IOpenApiMediaType.Example virou read-only) e o source generator
      do Microsoft.AspNetCore.OpenApi 10.0.9 é compilado contra a 2.x — o build quebra.

      Remover este pin quando o ASP.NET passar a trazer uma versão já corrigida.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup Label="Persistência">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup Label="Identity / Auth">
    <!--
      Identity.Stores traz apenas as ENTIDADES (IdentityUser, IdentityRole) e o UserManager,
      sem arrastar ASP.NET Core. É o que permite que Garius.Core (o domínio) declare
      ApplicationUser sem passar a conhecer HTTP — a dependência ficaria invertida.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />

    <!--
      Emissão do JWT (JwtSecurityTokenHandler). O JwtBearer traz a VALIDAÇÃO; para EMITIR
      o token é preciso este pacote, e ele mora na Infrastructure (onde está o JwtIssuer).
    -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup Label="Redis / Data Protection">
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.9" />

    <!--
      Pin transitivo de segurança. O DataProtection (acima) arrasta
      System.Security.Cryptography.Xml 10.0.9, que tem vulnerabilidade HIGH
      (GHSA-mmjf-rqrv-855v e outras — várias CVEs de parsing de XML assinado).

      Como o build audita CVE e trata NU1903 como ERRO, a 10.0.9 QUEBRA o build — e o
      CentralPackageTransitivePinningEnabled (ver PropertyGroup no topo) faz esta linha
      valer também para a dependência transitiva. Subir para 10.0.10 (a corrigida) sem
      tocar no DataProtection.

      ⚠️ Isto foi descoberto DERIVANDO uma app com o derive.ps1: o restore limpo da app
      nova disparou a auditoria, enquanto o template — com o pacote já em cache — passava.
      É o mesmo motivo pelo qual o `dotnet clean` é obrigatório antes de dar algo por
      pronto: cache esconde falha de restore.

      Remover quando o DataProtection passar a trazer a 10.0.10+ por conta própria.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Background jobs">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>

  <ItemGroup Label="Observabilidade">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Grafana.Loki" Version="9.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />

    <!--
      OpenTelemetry: TRAÇOS e MÉTRICAS. O Serilog cobre LOG, que é outra coisa.

      Log responde "o que aconteceu"; traço responde "onde foi o tempo". Sem traço, a
      pergunta "por que este request demorou 3s?" não tem resposta — sobra adivinhação.
      Com ele a resposta é a decomposição: 40ms na API, 2.9s numa query, 60ms no Redis.

      O OTel é vendor-neutral de propósito: o MESMO código exporta para Tempo, Jaeger ou
      Datadog. Trocar de backend é trocar uma variável de ambiente, não reinstrumentar a
      aplicação.

      ⚠️ NÃO há OpenTelemetry.Instrumentation.StackExchangeRedis aqui, e é deliberado: ele
      só existe em BETA (1.17.0-beta.1). Num template que serve de base para produção, uma
      dependência beta é dívida que se multiplica por cada app derivada. O Npgsql cobre a
      fonte dominante de latência (o banco); o Redis aparece nos traços como tempo dentro
      do span do request. Reavaliar quando sair a estável.
    -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Configuração / Secrets">
    <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Validação">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!--
      FakeTimeProvider. Testar coisa com janela de tempo (o cache do readiness, a expiração
      de token) esperando de VERDADE deixa a suíte lenta e instável — um teste que dorme 3s
      falha sozinho numa máquina carregada. Com o TimeProvider injetado, o tempo avança por
      chamada de método e o teste é determinístico.
    -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />

    <!--
      Pin transitivo de segurança. O Testcontainers usa SSH.NET (para o modo de execução
      remota do Docker) e arrasta a 2025.1.0, que tem vulnerabilidade HIGH
      (GHSA-q939-rpr3-3284).

      Como o build audita CVE e trata NU1903 como ERRO, a 2025.1.0 QUEBRA o build — e o
      CentralPackageTransitivePinningEnabled (ver PropertyGroup no topo) faz esta linha valer
      também para a dependência transitiva.

      ⚠️ É teste, não produção: o SSH.NET nunca vai para a imagem. Mas o build é estrito de
      PROPÓSITO, e a alternativa (excluir NU1903 da auditoria) desligaria o alarme para
      TODOS os pacotes, inclusive os de produção. Pinar é o conserto; suprimir é esconder.

      Remover quando o Testcontainers passar a trazer uma versão já corrigida.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
